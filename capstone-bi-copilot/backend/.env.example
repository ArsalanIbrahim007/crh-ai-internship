DATABASE_URL=sqlite:///./business_agent.db
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
DEVELOPMENT_AUTH_EMAIL=

# Server-side Google OAuth web-client settings. Enable the Calendar and Gmail
# APIs and register GOOGLE_REDIRECT_URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Optional. Leave blank to use GEMINI_MODEL for speech transcription.
VOICE_STT_MODEL=
VOICE_TTS_MODEL=gemini-2.5-flash-preview-tts
VOICE_TTS_VOICE=Kore
OAUTH_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
